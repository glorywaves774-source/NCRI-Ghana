# Copy these into your hosting dashboard's environment settings (or export them before starting).
PORT=3000
BASE_URL=https://www.your-domain.org
ADMIN_EMAIL=you@your-domain.org
ADMIN_PASSWORD=choose-a-long-password-first-run-only
# Keep your database and uploads on a persistent disk:
DATA_DIR=/var/data/ncri
# Behind a proxy such as Nginx, Render or Railway:
TRUST_PROXY=1
# Online giving (leave blank until you have verified accounts):
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Backups (automatic, about once a day). Point BACKUP_DIR at a different disk if you can:
# BACKUP_DIR=/var/backups/ncri
# BACKUP_KEEP=14
# BACKUP_DISABLE=1
# Where security researchers can reach you (shown at /.well-known/security.txt):
# SECURITY_EMAIL=info@ncri-ghana.org
